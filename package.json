{
  "name": "mmachine-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "sync-data": "python scripts/regen_website_data.py",
    "sync-data-legacy": "node scripts/sync-data.mjs",
    "sync-excel": "python scripts/phase2/sync_phase2.py",
    "export-pdfs": "powershell -ExecutionPolicy Bypass -File scripts/phase2/export_pdfs.ps1",
    "version-catalogues": "python scripts/write_catalogue_versions.py",
    "validate-sync": "python scripts/validate_sync.py",
    "test": "npm run test:uploads && npm run test:emails",
    "test:uploads": "node scripts/test_quote_uploads.cjs",
    "test:emails": "node scripts/test_quote_emails.cjs",
    "daily-sync": "npm run sync-data && npm run sync-excel && npm run export-pdfs && npm run version-catalogues && npm run validate-sync",
    "deploy": "opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare upload",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && npm run deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1095.0",
    "@smithy/fetch-http-handler": "^5.6.11",
    "next": "^16.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.160.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5",
    "wrangler": "^4.100.0"
  }
}
