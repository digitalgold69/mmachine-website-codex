{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mmachine-website-codex",
  "main": ".open-next/worker.js",
  "keep_vars": true,
  "compatibility_date": "2026-07-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://mmachine-website-codex.muddy-silence-4f5b.workers.dev",
    "AWS_SES_REGION": "eu-north-1",
    "AWS_SES_FROM_EMAIL": "orders@orders.m-machine.co.uk",
    "AWS_SES_FROM_NAME": "orders@m-machine.co.uk"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mmachine-runtime",
      "database_id": "5278be02-178b-40e7-b5ed-fc4f8bdbf284"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FEATURED_IMAGES",
      "bucket_name": "mmachine-featured-images"
    },
    {
      "binding": "QUOTE_FILES",
      "bucket_name": "mmachine-quote-files"
    }
  ],
  "observability": {
    "enabled": true
  }
}
